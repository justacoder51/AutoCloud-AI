# Copy to .env locally; Uvicorn does not load this file automatically.
# Set variables in PowerShell or use Docker --env-file .env.
APP_NAME=AutoCloud AI
APP_ENV=development
PORT=8080
LOG_LEVEL=INFO
GCP_PROJECT_ID=astute-sign-506809-j8
GCP_REGION=asia-south1
MIN_INSTANCES=0
MAX_INSTANCES=2
# Used only by the explicit --use-gemini workflow; ADC authenticates to Vertex AI.
VERTEX_MODEL=gemini-3.5-flash-lite
# Optional trusted native candidate directory; unset until a real training run completes.
# DASHBOARD_FORECAST_RUN=models/runs/EXPLICIT_RUN_DIRECTORY
# Manual dashboard analysis. Enable Gemini only after its inference permission is approved.
DASHBOARD_GEMINI_ENABLED=false
DASHBOARD_GEMINI_MODEL=gemini-3.5-flash-lite
# Set on BOTH API and dashboard for a fixed, read-only public showcase.
# Disables billing, reviews, Gemini controls, authentication and onboarding routes.
# Public Cloud Run invocation must be granted to the dashboard only.
DASHBOARD_PUBLIC_SHOWCASE=false
# Existing export only. No discovery, provisioning or IAM changes occur.
DASHBOARD_BILLING_TABLE=astute-sign-506809-j8.autocloud_billing.gcp_billing_export_v1_011640_0793FF_B5C560

# Explicit testing only: no app-level hourly/daily Gemini budget; button clicks remain billable.
DASHBOARD_GEMINI_TESTING_UNLIMITED=false

# Optional: archive already-computed future forecasts to the configured GCS bucket.
DASHBOARD_VALIDATION_LEDGER_ENABLED=false
